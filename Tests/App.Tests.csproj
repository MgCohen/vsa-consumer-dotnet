<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <!-- NUnit on Microsoft.Testing.Platform (global.json). -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host gives each module layer to the tests. -->
    <ProjectReference Include="../App/Host/App.Host.csproj" />
    <PackageReference Include="VSA.Testing.Architecture" Version="0.1.0-preview.14" />
    <PackageReference Include="VSA.Testing.Unit" Version="0.1.0-preview.14" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
</Project>
