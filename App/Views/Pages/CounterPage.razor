@page "/counter"
@using Counter.Presenters
@inject CounterPresenter Presenter

<PageTitle>Counter</PageTitle>
<h1>Counter</h1>
@if (Presenter.Load.Error is { } error) {
    <p class="error">@error</p>
}
<p>Status: @Presenter.Status</p>

@code {
    protected override Task OnInitializedAsync() => Presenter.LoadAsync();
}
